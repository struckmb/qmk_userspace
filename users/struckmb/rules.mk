CAPS_WORD_ENABLE = yes

COMBO_ENABLE = yes
INTROSPECTION_KEYMAP_C = $(USER_PATH)/struckmb.c

# OLED_ENABLE = yes

# Erlaubt fortgeschrittene Hold-Tap-Filter-Regeln in der config.h
TAP_DANCE_ENABLE = no

# Aktiviert die Makro-Unterstützung (wichtig für SEND_STRING)
COMMAND_ENABLE = no

# Optimiert die Firmware-Größe und entfernt ungenutzten Code
AVR_USE_MINIMAL_PRINTF = yes
CONSOLE_ENABLE = no
GRAVE_ESC_ENABLE = no
SPACE_CADET_ENABLE = no

LTO_ENABLE = yes


