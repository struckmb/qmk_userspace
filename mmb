#!/bin/sh

# Make My Board!

KB_CHARYBDIS="bastardkb/charybdis/3x6/v2/splinky_2"
KB_KYRIA="splitkb/kyria/rev1"
KB_REDOX="redox/rev1"

CMD="qmk"
ACTION="compile"
KEYBOARD=""
KEYMAP="struckmb"
SIDE="left"
CLEAN_UP="false"
TEST_MODE="false"
ALL_KEYBOARDS="false"
BOTH_SIDES="false"
SIDE_SPECIFIED="false"

show_help() {
    cat << EOF

Verwendung: $(basename "$0") [Optionen] [-a | <kb>] [Optionen]

Optionen:
    -a      Kompiliert alle Keyboards mit der gewählten Keymap in keyboards/
    -b      Flash-Vorgang für beide Seiten ausführen (links, dann rechts)
    -c      Clean: Führt 'qmk clean' aus und löscht alle .hex, .bin, .uf2 Dateien
    -f      Flashen der Firmware
    -h      Zeigt diese Hilfe an
    -l      Kompiliert für die LINKE Seite (Standard)
    -m <km> Verwendet eine eigene Keymap (Standard: struckmb)
    -r      Kompiliert für die RECHTE Seite
    -t      Testmodus (Gibt die Befehle nur im Terminal aus)

Keyboard: charybdis, kyria, redox oder ein eigener Pfad
Optionen können vor oder nach dem Keyboard stehen. -a kann nicht mit <kb> kombiniert werden.

EOF
}

clean_firmware() {
    if [ "$TEST_MODE" = "false" ]; then
        echo "Führe QMK Clean aus..."
    fi
    run_command "$CMD" clean

    if [ "$CMD" = "qmk" ]; then
        if [ "$TEST_MODE" = "false" ]; then
            echo "Räume Firmware-Dateien im aktuellen Verzeichnis auf..."
        fi
        run_command rm -f ./*.hex ./*.bin ./*.uf2
    fi
    if [ "$TEST_MODE" = "false" ]; then
        echo "--> Aufräumen beendet."
    fi
}

run_command() {
    if [ "$TEST_MODE" = "true" ]; then
        printf '+ %s\n' "$*"
        return 0
    fi
    "$@"
}

read_key() {
    tty_settings=$(stty -g < /dev/tty) || return 1
    if ! stty -icanon -echo min 1 time 0 < /dev/tty; then
        return 1
    fi
    trap 'stty "$tty_settings" < /dev/tty' 0
    answer=$(dd bs=1 count=1 2>/dev/null < /dev/tty)
    read_status=$?
    stty "$tty_settings" < /dev/tty || return 1
    trap - 0
    printf '\n'
    return "$read_status"
}

compile_keyboard() {
    keyboard="$1"
    if [ "$ACTION" = "flash" ]; then
        if [ "$BOTH_SIDES" = "true" ]; then
            for flash_side in left right; do
                if [ "$flash_side" = "right" ] && [ "$TEST_MODE" = "false" ]; then
                    sleep 3
                fi
                if [ "$TEST_MODE" = "false" ]; then
                    echo "keyboard: ${keyboard}, keymap: ${KEYMAP}, side: ${flash_side}"
                fi
                if [ "$keyboard" = "cantor" ]; then
                    if ! run_command "$CMD" "$ACTION" -kb "$keyboard" -km "$KEYMAP" -bl "dfu-util-split-${flash_side}"; then
                        echo "--> Fehler beim QMK Befehl für ${keyboard} (${flash_side})!" >&2
                        return 1
                    fi
                elif ! run_command "$CMD" "$ACTION" -kb "$keyboard" -km "$KEYMAP"; then
                    echo "--> Fehler beim QMK Befehl für ${keyboard} (${flash_side})!" >&2
                    return 1
                fi
            done
            return 0
        fi

        if [ "$keyboard" = "cantor" ]; then
            if [ "$TEST_MODE" = "false" ]; then
                echo "keyboard: ${keyboard}, keymap: ${KEYMAP}, side: ${SIDE}"
            fi
            if ! run_command "$CMD" "$ACTION" -kb "$keyboard" -km "$KEYMAP" -bl "dfu-util-split-${SIDE}"; then
                echo "--> Fehler beim QMK Befehl für ${keyboard} (${SIDE})!" >&2
                return 1
            fi
            return 0
        fi
    fi

    if [ "$TEST_MODE" = "false" ]; then
        echo "keyboard: ${keyboard}, keymap: ${KEYMAP}"
    fi

    if ! run_command "$CMD" "$ACTION" -kb "$keyboard" -km "$KEYMAP"; then
        echo "--> Fehler beim QMK Befehl für ${keyboard}!" >&2
        return 1
    fi

    if [ "$TEST_MODE" = "false" ]; then
        echo "--> QMK Befehl erfolgreich ausgeführt!"
    fi

    if [ "$keyboard" = "cantor" ]; then
        if [ "$TEST_MODE" = "false" ]; then
            run_command rm -f cantor_"${KEYMAP}"*
            echo "removed unusable firmware (use flash and select correct side)"
        fi
    fi
}

# 1. Erst alle Optionen sammeln (damit -t auch vor -c wirkt und das Keyboard
#    an beliebiger Position stehen kann)
POSITIONAL_COUNT=0
while [ "$#" -gt 0 ]; do
    case "$1" in
    --)
        shift
        while [ "$#" -gt 0 ]; do
            POSITIONAL_COUNT=$((POSITIONAL_COUNT + 1))
            if [ "$POSITIONAL_COUNT" -eq 1 ]; then
                KEYBOARD="$1"
            fi
            shift
        done
        ;;
    -?*)
        options=${1#-}
        shift
        while [ -n "$options" ]; do
            opt=${options%"${options#?}"}
            options=${options#?}
            case "$opt" in
            a) ALL_KEYBOARDS="true" ;;
            b) BOTH_SIDES="true"; ACTION="flash" ;;
            c) CLEAN_UP="true" ;;
            f) ACTION="flash" ;;
            h) show_help; exit 0 ;;
            l) SIDE="left"; SIDE_SPECIFIED="true" ;;
            m)
                if [ -n "$options" ]; then
                    KEYMAP="$options"
                    options=""
                elif [ "$#" -gt 0 ]; then
                    KEYMAP="$1"
                    shift
                else
                    echo "Fehler: -m benötigt eine Keymap als Argument!" >&2
                    show_help
                    exit 1
                fi
                ;;
            r) SIDE="right"; SIDE_SPECIFIED="true" ;;
            s) show_help; exit 1 ;;
            t) TEST_MODE="true" ;;
            *)
                echo "Fehler: Unbekannte Option -${opt}!" >&2
                show_help
                exit 1
                ;;
            esac
        done
        ;;
    *)
        POSITIONAL_COUNT=$((POSITIONAL_COUNT + 1))
        if [ "$POSITIONAL_COUNT" -eq 1 ]; then
            KEYBOARD="$1"
        fi
        shift
        ;;
    esac
done

if [ "$BOTH_SIDES" = "true" ] && [ "$SIDE_SPECIFIED" = "true" ]; then
    echo "Fehler: -b kann nicht mit -l oder -r kombiniert werden!" >&2
    show_help
    exit 1
fi
if [ "$POSITIONAL_COUNT" -gt 1 ] || { [ "$ALL_KEYBOARDS" = "true" ] && [ "$POSITIONAL_COUNT" -gt 0 ]; }; then
    echo "Fehler: -a kann nicht mit einem einzelnen Keyboard kombiniert werden; ansonsten ist höchstens ein Keyboard erlaubt!" >&2
    show_help
    exit 1
fi

if [ "$ALL_KEYBOARDS" = "false" ] && [ "$POSITIONAL_COUNT" -eq 1 ]; then
    if [ "$KEYBOARD" = "bastardkb" ] || [ "$KEYBOARD" = "charybdis" ]; then
        KEYBOARD="$KB_CHARYBDIS"
    elif [ "$KEYBOARD" = "kyria" ]; then
        KEYBOARD="$KB_KYRIA"
    elif [ "$KEYBOARD" = "redox" ]; then
        KEYBOARD="$KB_REDOX"
    fi
fi

if [ "$TEST_MODE" = "true" ]; then
    echo "Testmodus: Es werden keine Befehle ausgeführt."
fi

# 2. Clean-Befehl ausführen (Testmodus -t funktioniert nun unabhängig von der Argumentenreihenfolge)
if [ "$CLEAN_UP" = "true" ]; then
    clean_firmware
    if [ -z "$KEYBOARD" ] && [ "$ALL_KEYBOARDS" = "false" ]; then
        if [ "$TEST_MODE" = "true" ]; then
            echo "Testmodus beendet: Es wurden keine Dateien verändert."
        fi
        exit 0
    fi
fi

# 3. Validierung
if [ -z "$KEYBOARD" ] && [ "$ALL_KEYBOARDS" = "false" ]; then
    echo "Fehler: Es wurde keine Tastatur angegeben!" >&2
    show_help
    exit 1
fi

# 4. Hauptlogik
if [ "$ALL_KEYBOARDS" = "true" ]; then
    KEYMAP_FILES=$(find keyboards -type f -path "*/keymaps/${KEYMAP}/keymap.c" -print | sort)
    if [ -z "$KEYMAP_FILES" ]; then
        echo "Fehler: Keine Keyboards mit der Keymap '${KEYMAP}' in keyboards/ gefunden!" >&2
        exit 1
    fi

    FAILED="false"
    for KEYMAP_FILE in $KEYMAP_FILES; do
        KEYBOARD_DIR=${KEYMAP_FILE%/keymaps/${KEYMAP}/keymap.c}
        case "$KEYBOARD_DIR" in
        keyboards/bastardkb/charybdis/3x6) KEYBOARD="$KB_CHARYBDIS" ;;
        keyboards/splitkb/kyria/rev1/base) KEYBOARD="$KB_KYRIA" ;;
        *) KEYBOARD=${KEYBOARD_DIR#keyboards/} ;;
        esac

        if [ "$TEST_MODE" = "false" ]; then
            if [ "$ACTION" = "flash" ]; then
                action_label="flashen"
            else
                action_label="kompilieren"
            fi
            while :; do
                printf "Keyboard %s %s? (y/n): " "$KEYBOARD" "$action_label"
                if ! read_key; then
                    echo "Fehler: Eingabe über das Terminal nicht möglich." >&2
                    exit 1
                fi
                case "$answer" in
                y|Y) break ;;
                n|N) continue 2 ;;
                *) echo "Bitte y oder n eingeben." >&2 ;;
                esac
            done
        fi

        if ! compile_keyboard "$KEYBOARD"; then
            FAILED="true"
        fi
    done
    if [ "$FAILED" = "true" ]; then
        exit 1
    fi
else
    if ! compile_keyboard "$KEYBOARD"; then
        exit 1
    fi
fi

if [ "$TEST_MODE" = "true" ]; then
    echo "Testmodus beendet: Es wurden keine Dateien verändert."
fi
